#!/usr/bin/env python3

import rclpy
from rclpy.node import Node
from nav_msgs.msg import Path, Odometry
from geometry_msgs.msg import Twist, PoseStamped
from tf2_ros import TransformListener, Buffer
import math
import numpy as np

class Controller(Node):
    def __init__(self):
        super().__init__('controller')
        
        # Publishers
        self.cmd_vel_pub = self.create_publisher(Twist, '/cmd_vel', 10)
        
        # Subscribers
        self.path_sub = self.create_subscription(Path, '/global_path', self.path_callback, 10)
        self.odom_sub = self.create_subscription(Odometry, '/odom', self.odom_callback, 10)
        
        # TF listener
        self.tf_buffer = Buffer()
        self.tf_listener = TransformListener(self.tf_buffer, self)
        
        # Controller parameters
        self.lookahead_distance = 0.5  # meters
        self.max_linear_velocity = 0.2  # m/s
        self.max_angular_velocity = 1.0  # rad/s
        self.goal_tolerance = 0.1  # meters
        
        # State variables
        self.current_path = None
        self.current_pose = None
        self.path_index = 0
        self.is_navigating = False
        self.odom_received = False
        
        # Timer for control loop
        self.control_timer = self.create_timer(0.1, self.control_loop)  # 10 Hz
        
        self.get_logger().info("Controller initialized")
        
    def path_callback(self, msg):
        """Handle new path from global planner"""
        self.current_path = msg.poses
        self.path_index = 0
        self.is_navigating = True
        self.get_logger().info(f"Received path with {len(self.current_path)} waypoints")
        
    def odom_callback(self, msg):
        """Update current robot pose from odometry"""
        self.current_pose = msg.pose.pose
        if not self.odom_received:
            self.odom_received = True
            self.get_logger().info("Received first odometry data")
        
    def get_distance_to_goal(self):
        """Calculate distance to current goal"""
        if not self.current_path or self.path_index >= len(self.current_path):
            return float('inf')
            
        goal = self.current_path[self.path_index]
        dx = goal.pose.position.x - self.current_pose.position.x
        dy = goal.pose.position.y - self.current_pose.position.y
        return math.sqrt(dx*dx + dy*dy)
        
    def get_angle_to_goal(self):
        """Calculate angle to current goal"""
        if not self.current_path or self.path_index >= len(self.current_path):
            return 0.0
            
        goal = self.current_path[self.path_index]
        dx = goal.pose.position.x - self.current_pose.position.x
        dy = goal.pose.position.y - self.current_pose.position.y
        return math.atan2(dy, dx)
        
    def get_robot_heading(self):
        """Extract robot heading from quaternion"""
        if not self.current_pose:
            return 0.0
            
        # Convert quaternion to euler angles (simplified)
        q = self.current_pose.orientation
        return math.atan2(2.0 * (q.w * q.z + q.x * q.y), 1.0 - 2.0 * (q.y * q.y + q.z * q.z))
        
    def pure_pursuit_control(self):
        """Pure pursuit control algorithm"""
        if not self.current_path or not self.current_pose or self.path_index >= len(self.current_path):
            return Twist()
            
        # Find lookahead point
        lookahead_point = self.find_lookahead_point()
        if lookahead_point is None:
            return Twist()
            
        # Calculate curvature
        dx = lookahead_point[0] - self.current_pose.position.x
        dy = lookahead_point[1] - self.current_pose.position.y
        distance = math.sqrt(dx*dx + dy*dy)
        
        if distance < 0.001:
            return Twist()
            
        # Calculate angle to lookahead point
        alpha = math.atan2(dy, dx) - self.get_robot_heading()
        
        # Normalize angle
        while alpha > math.pi:
            alpha -= 2 * math.pi
        while alpha < -math.pi:
            alpha += 2 * math.pi
            
        # Calculate curvature
        curvature = 2.0 * math.sin(alpha) / distance
        
        # Generate velocity commands
        cmd_vel = Twist()
        cmd_vel.linear.x = min(self.max_linear_velocity, distance * 0.5)
        cmd_vel.angular.z = curvature * cmd_vel.linear.x
        
        # Limit angular velocity
        if abs(cmd_vel.angular.z) > self.max_angular_velocity:
            cmd_vel.angular.z = math.copysign(self.max_angular_velocity, cmd_vel.angular.z)
            
        return cmd_vel
        
    def find_lookahead_point(self):
        """Find the lookahead point on the path"""
        if not self.current_path or not self.current_pose:
            return None
            
        robot_pos = [self.current_pose.position.x, self.current_pose.position.y]
        
        # Search for lookahead point starting from current path index
        for i in range(self.path_index, len(self.current_path)):
            path_point = self.current_path[i]
            point_pos = [path_point.pose.position.x, path_point.pose.position.y]
            
            distance = math.sqrt((point_pos[0] - robot_pos[0])**2 + (point_pos[1] - robot_pos[1])**2)
            
            if distance >= self.lookahead_distance:
                return point_pos
                
        # If no lookahead point found, use the last point
        if self.current_path:
            last_point = self.current_path[-1]
            return [last_point.pose.position.x, last_point.pose.position.y]
            
        return None
        
    def control_loop(self):
        """Main control loop"""
        if not self.is_navigating or not self.current_path:
            return
            
        if not self.current_pose:
            self.get_logger().warn("No robot pose available")
            return
            
        # Check if we've reached the current waypoint
        distance_to_goal = self.get_distance_to_goal()
        if distance_to_goal < self.goal_tolerance:
            self.path_index += 1
            self.get_logger().info(f"Reached waypoint {self.path_index-1}/{len(self.current_path)}")
            
        # Check if we've reached the final goal
        if self.path_index >= len(self.current_path):
            self.is_navigating = False
            self.get_logger().info("Navigation completed!")
            # Stop the robot
            cmd_vel = Twist()
            self.cmd_vel_pub.publish(cmd_vel)
            return
            
        # Generate control commands
        cmd_vel = self.pure_pursuit_control()
        
        # Log velocity commands
        if abs(cmd_vel.linear.x) > 0.01 or abs(cmd_vel.angular.z) > 0.01:
            self.get_logger().info(f"Publishing cmd_vel: linear.x={cmd_vel.linear.x:.3f}, angular.z={cmd_vel.angular.z:.3f}")
        
        self.cmd_vel_pub.publish(cmd_vel)
        
        # Log progress
        if self.path_index < len(self.current_path):
            goal = self.current_path[self.path_index]
            self.get_logger().debug(f"Moving to waypoint {self.path_index}: ({goal.pose.position.x:.2f}, {goal.pose.position.y:.2f})")

def main(args=None):
    rclpy.init(args=args)
    node = Controller()
    rclpy.spin(node)
    node.destroy_node()
    rclpy.shutdown()

if __name__ == '__main__':
    main() 